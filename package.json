{
  "name": "browser-memory-engine",
  "version": "0.1.0",
  "description": "Browser Memory Engine (BME) — a framework for building AI companions with long-term memory, running entirely in the browser via IndexedDB",
  "type": "module",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "ai",
    "memory",
    "browser",
    "indexeddb",
    "llm",
    "companion",
    "bm25",
    "dexie"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "dexie": "^4.0.10",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.3.5",
    "vue-tsc": "^2.2.10"
  }
}
